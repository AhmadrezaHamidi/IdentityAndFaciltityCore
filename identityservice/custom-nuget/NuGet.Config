<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget-group" value="https://nuget.abromid.ir/repository/nuget-group/index.json" />
  </packageSources>
  <config>
    <add key="http_timeout" value="100" />
    <add key="maxHttpRequestsPerSource" value="8" />
    <add key="signatureValidationMode" value="accept" />
  </config>
</configuration>