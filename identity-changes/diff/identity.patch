+public sealed record UpdatePanelUserCommand(
+    int Id,
+    string UserName,
+    string? NewPassword,
+    string? Email,
+    string? FullName,
+    string? UserCode,
+    string? BranchCode,
+    string? BranchName,
+    bool IsActive,
+    List<RoleAssignmentDto>? Roles,
+    int? ActorPanelUserId = null) : BaseCommand<BaseMessageResponse<PanelUserDetails>>;
